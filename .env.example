# release-r2.sh 发布配置样例：复制为仓库根 .env（勿提交）后按需填写。
# Cloudflare R2 凭证（必备）：https://dash.cloudflare.com → R2 → 管理 API 令牌
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 桶名（须已在 Cloudflare 开启公开访问并绑定自定义域）
R2_BUCKET=app-updates
# 公开访问自定义域（不含 https://），如 update.example.com
R2_PUBLIC_DOMAIN=
# R2 内对象前缀：init-app 起底后默认按 app 名隔离（updates/<app 名>），可覆盖
#REMOTE_PREFIX=updates/my_app
